# OpenEir — environment configuration
# Copy this file to .env and adjust. Everything here has a safe default.

# SQLite database location.
# The path is resolved relative to the prisma/ schema directory,
# so ../db points at the db/ folder in the project root.
# In Docker the image sets DATABASE_URL=file:/app/db/custom.db for you.
DATABASE_URL="file:../db/custom.db"

# Optional: master key used to encrypt AI provider API keys at rest.
# Leave empty to auto-generate a key file (db/.appkey) on first run.
# If you set it, back it up together with the database — losing it
# means stored provider API keys can no longer be decrypted.
# APP_KEY=""

# Optional: port for the Next.js server (default 3000).
# PORT=3000

# Authentication is ON by default: a fresh instance stays locked until the
# first (admin) account is created at /login. Set OPENEIR_HOUSEHOLD=1 ONLY on
# a trusted LAN if you want the classic no-password household mode. Never use
# this on a public URL.
# OPENEIR_HOUSEHOLD=0

# Set to 1 when serving over HTTPS/TLS so the session cookie is marked Secure.
# OPENEIR_SECURE_COOKIE=0
