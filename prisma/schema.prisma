// ============================================================
// OpenEir — self-hosted AI medical assistant: health domains, ambient intelligence, agent harness
// Prisma schema (SQLite). JSON-ish fields are stored as strings
// and parsed through typed helpers in src/lib/*
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Singleton user profile + clinical targets + preferences
model Profile {
  id                String   @id @default(cuid())
  fullName          String   @default("Friend")
  birthYear         Int?
  sex               String? // male | female | other
  heightCm          Float?
  conditions        String   @default("[]") // JSON string[]
  notes             String?
  // Clinical targets
  bpSystolicTarget  Int      @default(130)
  bpDiastolicTarget Int      @default(80)
  glucoseTargetMin  Float    @default(4.4) // mmol/L fasting floor
  glucoseTargetMax  Float    @default(7.2) // mmol/L ceiling
  glucoseUnit       String   @default("mmol") // mmol | mgdl
  weightTargetKg    Float?
  onboarded         Boolean  @default(false)
  // General practitioner / primary care (filled via map search in the wizard)
  gpName            String? // Dr. Jane Smith
  gpOrg             String? // Riverside Family Practice
  gpAddress         String?
  gpPhone           String?
  gpWebsite         String?
  gpPlaceId         String? // Google Places id (or nominatim osm id) for provenance
  gpPlusCode        String? // Open Location Code for dispatchers
  gpNotes           String?
  // Appearance / a11y / language / ai autonomy / quiet hours (JSON)
  prefs             String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model BpReading {
  id        String   @id @default(cuid())
  systolic  Int
  diastolic Int
  pulse     Int?
  arm       String   @default("left") // left | right
  label     String   @default("general") // morning | evening | pre_med | post_med | general
  tags      String   @default("[]") // JSON string[]: stress, exercise, illness...
  notes     String?
  source    String   @default("manual") // manual | bluetooth | import
  takenAt   DateTime
  createdAt DateTime @default(now())

  @@index([takenAt])
}

model GlucoseReading {
  id      String   @id @default(cuid())
  value   Float // canonical mmol/L
  context String   @default("random") // fasting | pre_meal | post_meal | bedtime | random
  carbs   Float?
  tags    String   @default("[]")
  notes   String?
  source  String   @default("manual")
  takenAt DateTime
  createdAt DateTime @default(now())

  @@index([takenAt])
}

model Medication {
  id              String   @id @default(cuid())
  name            String
  doseValue       Float
  doseUnit        String   @default("mg")
  form            String   @default("tablet") // tablet | capsule | injection | drops | other
  purpose         String?
  scheduleTimes   String   @default("[]") // JSON ["08:00","20:00"]
  instructions    String?
  stock           Float? // remaining doses
  refillThreshold Float?
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  logs            MedicationLog[]
}

model MedicationLog {
  id            String  @id @default(cuid())
  medicationId  String
  medication    Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  date          String // YYYY-MM-DD (local)
  scheduledTime String // "08:00"
  status        String  @default("pending") // pending | taken | skipped | delayed | missed
  actualTime    String?
  note          String?
  createdAt     DateTime @default(now())

  @@unique([medicationId, date, scheduledTime])
  @@index([date])
}

model LifestyleLog {
  id           String  @id @default(cuid())
  date         String  @unique // YYYY-MM-DD
  mood         Int? // 1..5
  energy       Int? // 1..5
  sleepQuality Int? // 1..5
  stress       Int? // 1..5
  weightKg     Float?
  sodiumHigh   Boolean?
  notes        String?
  createdAt    DateTime @default(now())
}

/// Ambient AI insights surfaced across the UI
model Insight {
  id         String   @id @default(cuid())
  kind       String // pattern | anomaly | warning | celebration | tip | summary | correlation | coach
  severity   String   @default("info") // info | low | medium | high | critical
  title      String
  body       String // plain-language narrative
  dataJson   String? // structured payload for charts/links
  sourceEvent String?
  origin     String   @default("rule") // rule | ai | agent
  status     String   @default("new") // new | seen | dismissed | actioned
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Event-driven nervous system: every notable app event lands here
model EventRecord {
  id        String   @id @default(cuid())
  type      String // READING_LOGGED, MEDICATION_MISSED, PATTERN_ANOMALY...
  priority  String   @default("normal") // low | normal | high | critical
  payload   String   @default("{}")
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([type])
}

/// Provider-agnostic AI configuration (fallback chain by priority)
model AiProviderConfig {
  id            String  @id @default(cuid())
  label         String
  adapter       String  @default("openai_compatible") // builtin_zai | openai_compatible | anthropic | ollama
  baseUrl       String?
  model         String?
  apiKeyEnc     String? // AES-256-GCM encrypted
  enabled       Boolean @default(true)
  isDefault     Boolean @default(false)
  priority      Int     @default(100) // lower = tried first
  costPer1kIn   Float?
  costPer1kOut  Float?
  privacyMode   Boolean @default(false) // strip PII before sending
  lastStatus    String?
  lastLatencyMs Int?
  createdAt     DateTime @default(now())
}

model AiUsage {
  id            String   @id @default(cuid())
  providerLabel String
  model         String?
  purpose       String // insight | story | whatif | report | chat
  tokensIn      Int      @default(0)
  tokensOut     Int      @default(0)
  latencyMs     Int      @default(0)
  estimatedCost Float    @default(0)
  ok            Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// Cached "Blood Pressure Story" weekly narratives
model StoryEntry {
  id        String   @id @default(cuid())
  weekStart String // YYYY-MM-DD (Monday)
  period    String   @default("week") // week | month
  content   String
  statsJson String?
  createdAt DateTime @default(now())

  @@unique([weekStart, period])
}

model WhatIfScenario {
  id             String   @id @default(cuid())
  question       String
  paramsJson     String
  projectionJson String
  narrative      String?
  createdAt      DateTime @default(now())
}

/// Conversation with Eir — one persistent thread (WhatsApp-style), full app context
model ChatMessage {
  id          String   @id @default(cuid())
  role        String // user | assistant
  content     String
  /// structured extras: detected health intents, provider info, voice provenance
  meta        String   @default("{}")
  channel     String   @default("text") // text | voice
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

/// Key/value store for reminders, language pack cache, etc.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Emergency contact with EVERY viable channel (SOS blasts all of them)
model EmergencyContact {
  id           String  @id @default(cuid())
  name         String
  relationship String  @default("family") // family | friend | carer | neighbour | other
  isPrimary    Boolean @default(false)
  /// JSON [{ type: 'phone'|'whatsapp'|'email'|'signal'|'other', value, label? }]
  channels     String  @default("[]")
  notes        String?
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  @@index([active])
}

/// Trusted person ("responsible adult") paired to the user — can check in
/// remotely. Pairing is consent-based, revocable and audit-logged.
model CompanionLink {
  id           String    @id @default(cuid())
  name         String    @default("Companion")
  contact      String? // phone or email for the invite
  /// one-time pairing token (hashed at rest); single-use, expires
  tokenHash    String    @unique
  /// long-lived viewing token (hashed) — issued at activation, kept on the companion's device
  viewerHash   String?   @unique
  status       String    @default("invited") // invited | active | revoked
  /// JSON string[] — scopes granted: status | meds | vitals | location | live_audio
  scopes       String    @default("[\"status\",\"meds\",\"vitals\"]")
  alsoEmergency Boolean  @default(true) // auto-added to emergency contacts on activation
  invitedAt    DateTime  @default(now())
  activatedAt  DateTime?
  lastSeenAt   DateTime?

  @@index([status])
}

/// Web Push subscription for outbound notifications (SOS, companion nudge, briefing)
model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique
  p256dh        String // client public key (base64url)
  auth          String // auth secret (base64url)
  label         String    @default("This device")
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?
}

/// Three-tier long-term memory for Eir (core = pinned, semantic = durable facts,
/// episodic = decaying day-notes). Written by deterministic extractors + optional
/// AI extraction + the nightly reflection.
model MemoryEntry {
  id             String    @id @default(cuid())
  tier           String    @default("episodic") // core | semantic | episodic
  content        String // third-person, self-contained ("User prefers morning walks")
  kind           String    @default("fact") // fact | preference | person | plan | health | reflection
  importance     Float     @default(0.5) // 0..1 — drives ordering, promotion and decay
  pinned         Boolean   @default(false) // core tier: never decays
  sourceMsgId    String? // provenance: chat message that produced it
  dedupeKey      String? // normalized key for duplicate suppression
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  expiresAt      DateTime? // episodic decay horizon
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tier])
  @@index([dedupeKey])
}

/// One emergency activation — the full audit trail + dispatcher package
model EmergencyEvent {
  id          String    @id @default(cuid())
  kind        String    @default("sos") // sos | fall | checkin_missed
  status      String    @default("active") // active | cancelled | resolved
  /// JSON { lat, lng, accuracyM } — captured at trigger time
  location    String?
  /// JSON { country, emergencyNumber, nearest: { name, address, phone, distanceM } | null, plusCode? , mapsUrl }
  context     String?
  /// Full dispatcher package snapshot (profile, readings, meds, contacts…)
  packageJson String?
  /// Public read-only share token for the dispatcher card page
  shareToken  String    @unique
  /// JSON channel names attempted: ["push","email","sms","whatsapp"]
  notifiedVia String    @default("[]")
  note        String?
  startedAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status])
  @@index([startedAt])
}

/// Remote MCP server this instance CONNECTS to (client mode).
/// v1 scope: streamable HTTP / SSE only — no local process spawning.
model McpServer {
  id          String    @id @default(cuid())
  name        String
  url         String // https://host/mcp (streamable HTTP endpoint)
  headerName  String    @default("Authorization") // header carrying the credential
  tokenEnc    String? // AES-256-GCM encrypted header value
  enabled     Boolean   @default(true)
  status      String    @default("untested") // untested | ok | error
  lastError   String?
  toolsJson   String    @default("[]") // last known tool list (JSON [{name,description}])
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
}

/// Registered external plugin (manifest-URL install, scoped access token).
/// The token is shown once at enable time; only its sha256 is stored.
model Plugin {
  id          String    @id @default(cuid())
  name        String
  manifestUrl String    @unique
  version     String    @default("0.0.0")
  description String    @default("")
  baseUrl     String? // where the plugin serves its own endpoints (optional)
  scopes      String    @default("[]") // JSON string[]: read:vitals | read:meds | read:profile | read:export | post:insights
  tokenHash   String    @unique // sha256 hex of the scoped token
  enabled     Boolean   @default(true)
  health      String    @default("unknown") // unknown | healthy | unreachable
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
}

/// Local account for access control. Roles: admin | caregiver | viewer.
/// While zero active accounts exist the instance runs in open household mode
/// (current behavior). Creating the first account switches auth_mode=accounts.
model Account {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String // scrypt: salt:hash (hex)
  role         String        @default("caregiver") // admin | caregiver | viewer
  displayName  String        @default("")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     AuthSession[]
}

/// Server-side session — cookie holds the raw token, DB keeps only its hash.
model AuthSession {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 hex of the raw cookie token
  userAgent String?
  createdAt DateTime  @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
}
